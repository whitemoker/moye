{
  "name": "moye",
  "version": "0.2.0-rc.3",
  "description": "墨页 · 专注本地写作的 Markdown 编辑器",
  "license": "SEE LICENSE IN LICENSE",
  "author": "whitemoker",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/whitemoker/moye.git"
  },
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "test": "node --test tests/storage.test.cjs tests/save-name.test.cjs tests/comments.test.cjs tests/comment-anchors.test.mjs tests/format-toggle.test.mjs",
    "test:e2e": "node tests/e2e.mjs",
    "test:contrast": "node tests/code-block-contrast.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "test:comments": "node tests/comments-e2e.mjs",
    "test:format": "node tests/format-toggle-e2e.mjs",
    "test:typography": "node tests/editor-typography-e2e.mjs"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.14",
    "@electron/packager": "^20.3.0",
    "@milkdown/crepe": "^7.22.3",
    "@milkdown/kit": "^7.22.3",
    "@types/markdown-it": "^14.2.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.17",
    "electron": "^39.8.3",
    "katex": "^0.19.0",
    "lucide-react": "^1.56.0",
    "markdown-it": "^15.0.2",
    "playwright": "^1.64.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  }
}
